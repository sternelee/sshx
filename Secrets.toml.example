# Required: keep this stable across restarts/redeploys.
SSHX_SECRET = "replace-this-with-a-long-random-secret"

# Optional: force sshx to generate share links with a stable public origin,
# e.g. a custom domain pointing at Shuttle.
# SSHX_OVERRIDE_ORIGIN = "https://sshx.example.com"

# Optional: Redis snapshot storage. Note that sshx's full multi-node mesh mode
# also needs per-instance hostnames, which Shuttle does not expose by default.
# SSHX_REDIS_URL = "redis://..."

# Optional: only for real multi-node mesh deployments with direct node routing.
# SSHX_HOST = "node-1.internal.example.com"
# SSHX_MESH_TLS = "true"
